APP_NAME=InnSYnc
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innsync
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_USERNAME=innsync
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=5
AUTH_PASSWORD_CONFIRM_TIMEOUT=900

# Q-15: leave blank to retain immutable evidence indefinitely until policy is approved.
AUDIT_MINIMUM_RETENTION_DAYS=
SECURITY_EVENT_MINIMUM_RETENTION_DAYS=

# Keep stable across APP_KEY rotation. Generate a separate high-entropy secret in production.
IDEMPOTENCY_HASH_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OUTBOX_QUEUE_CONNECTION=database
OUTBOX_QUEUE_NAME=outbox
OUTBOX_DRAIN_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAYS=60,300,900,1800
OUTBOX_JOB_TIMEOUT_SECONDS=45
OUTBOX_WORKER_MAX_TIME_SECONDS=50

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false
PRIVATE_FILES_DISK=private_files
HEALTH_TOKEN=

BACKUP_PATH=
BACKUP_ENCRYPTION_KEY=
BACKUP_RESTORE_TEST_DATABASE=
# Daily backup sets kept; default 35 (see docs/OPERATIONS/INDONESIA-COMPLIANCE-BASELINE.md). Empty keeps every set.
# BACKUP_KEEP_LAST=35

# Daily erasure of files whose retention ended (TASK-FND-019).
# RETENTION_PURGE_AT=03:30
# RETENTION_PURGE_BATCH=200
BACKUP_RUN_AT=02:00

# Key for lookups of protected personal data (guest ID numbers). Falls back to APP_KEY; set a separate secret and keep it stable.
# PRIVACY_BLIND_INDEX_KEY=
